{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "src.tessera_api.main:app",
      "installCommand": "uv pip install . 'derivlab @ https://github.com/enesozs/Derivatives-Pricing-Lab/archive/refs/heads/main.tar.gz#subdirectory=backend'"
    },
    "web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
